{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/simulator/engine.test.ts src/simulator/grounding.test.ts src/server/aiFacts.test.ts src/server/app.test.ts src/server/auth.test.ts src/server/categorize.test.ts src/server/db.test.ts src/server/kaggleImport.test.ts src/server/reporting.test.ts src/server/store.test.ts src/server/validation.test.ts src/forecast/benchmark.test.ts src/server/firestoreRepo.test.ts",
    "user:set-password": "tsx scripts/set-password.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "import:kaggle": "tsx scripts/import-kaggle.ts",
    "train:categorizer": "tsx scripts/train-categorizer.ts",
    "firestore:upload": "tsx scripts/firestore-upload.ts"
  },
  "dependencies": {
    "@fontsource-variable/anek-latin": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
