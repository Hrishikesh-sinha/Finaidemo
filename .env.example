# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ML_SERVICE_URL: Base URL of the Python forecasting service in ml-service/.
# Defaults to http://localhost:8000 when unset, for local development. In
# production point this at the deployed service (e.g. a Hugging Face Space).
# If it is unreachable the dashboard falls back to a flat projection and
# labels the figure as a heuristic rather than failing the request.
ML_SERVICE_URL="http://localhost:8000"

# AUTH_SECRET: signs session tokens. Server-side only; at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a random key is used for each run and everyone is signed out
# whenever the server restarts.
AUTH_SECRET=""

# DEMO_PASSWORD: only read when finai_store.json does not exist yet and the
# synthetic demo account is being created. Leave empty to set the password
# afterwards with `npm run user:set-password -- demo_user`.
DEMO_PASSWORD=""
